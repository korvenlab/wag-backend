# Copie para .env local (nunca commite .env). No Render/VPS use apenas secrets da plataforma.

PORT=3000

# Modelo estável recomendado: gemini-2.5-flash (evite *-preview descontinuados)
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

FRONTEND_URL=
# Origens CORS extras (vírgula). Padrão já inclui wagobot.com / wagoobot.com e localhost.
FRONTEND_ORIGINS=
# 1 = permite *.vercel.app em preview
CORS_ALLOW_VERCEL=

# Opcional: segredo dedicado para assinar o state do OAuth Google Calendar.
# Se vazio, usa GOOGLE_CLIENT_SECRET (ou SERVICE_ROLE em último caso).
GOOGLE_OAUTH_STATE_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
# Planos Wagoo (subscription metadata plan_tier=basic|pro|pro_plus)
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PRO_PLUS=
# Legado (fallback se os acima estiverem vazios)
STRIPE_PRICE_ID=
STRIPE_MULTI_BARBER_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Korven / métricas / admin HTTP (qualquer um deles pode ser o Bearer/X-API-Key do Console).
# No Korven Dashboard (dashboard-front): WAGOO_API_BASE_URL + o mesmo ADMIN_API_SECRET (ou WAGOO_METRICS_API_KEY).
ADMIN_API_SECRET=
API_SECRET=
METRICS_API_KEY=
