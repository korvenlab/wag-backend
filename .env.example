# Copie para .env local (nunca commite .env). No Render/VPS use apenas secrets da plataforma.

PORT=3000

# Modelo estável recomendado: gemini-2.5-flash (evite *-preview descontinuados)
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

FRONTEND_URL=
# Origens CORS extras (vírgula). Padrão já inclui wagobot.com / wagoobot.com e localhost.
FRONTEND_ORIGINS=
# 1 = permite *.vercel.app em preview
CORS_ALLOW_VERCEL=

# Opcional: segredo dedicado para assinar o state do OAuth Google Calendar.
# Se vazio, usa GOOGLE_CLIENT_SECRET (ou SERVICE_ROLE em último caso).
GOOGLE_OAUTH_STATE_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
# Planos Wagoo (subscription metadata plan_tier=agenda_web|basic|pro|pro_plus)
# Preferir Price ID (price_...) no checkout; Product ID (prod_...) é fallback no webhook.
STRIPE_PRICE_ID_AGENDA_WEB=
STRIPE_PRODUCT_ID_AGENDA_WEB=
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PRO_PLUS=
# Legado (fallback se os preços estiverem vazios)
STRIPE_PRICE_ID=
STRIPE_MULTI_BARBER_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Segundo destino (Contas conectadas / Connect) — signing secret diferente do webhook da plataforma.
# Dashboard → Webhooks → destino Connect → Revelar segredo.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Connect: no Dashboard Stripe, ative o webhook também para "Events on Connected accounts"
# (account.updated, checkout.session.completed, checkout.session.async_payment_*).
# Taxa Wagoo por sinal = 2% (application_fee). Taxa Stripe = processamento na conta Express.

# Mercado Pago (sinais / marketplace Split 1:1 — app WAGOO Market Place).
# Client ID = App ID. Webhook URL no painel MP:
#   https://wag-backend.onrender.com/api/mercadopago/webhook
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Segredo em Suas integrações → Webhooks → revelar chave (não é o Access Token).
MP_WEBHOOK_SECRET=
# OAuth vendedores (mesmo redirect cadastrado na app MP).
MP_OAUTH_REDIRECT_URI=https://wag-backend.onrender.com/api/mercadopago/oauth/callback

# Korven / métricas / admin HTTP (qualquer um deles pode ser o Bearer/X-API-Key do Console).
# No Korven Dashboard (dashboard-front): WAGOO_API_BASE_URL + o mesmo ADMIN_API_SECRET (ou WAGOO_METRICS_API_KEY).
ADMIN_API_SECRET=
API_SECRET=
METRICS_API_KEY=

# Wagoo -> Korven control plane (eventos HMAC + outbox Supabase).
DASHBOARD_INGEST_URL=
WAGOO_DASHBOARD_INGEST_SECRET=
# Opcionais; padrões: timeout 2500ms, 3 tentativas por drain, drain a cada 5000ms.
DASHBOARD_INGEST_TIMEOUT_MS=2500
DASHBOARD_INGEST_MAX_ATTEMPTS=3
DASHBOARD_INGEST_DRAIN_INTERVAL_MS=5000
